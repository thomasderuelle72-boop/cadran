DATABASE_URL="postgresql://cadran:cadran@localhost:5432/cadran?schema=public"
# Obligatoire, au moins 32 caractères, généré par exemple avec :
#   openssl rand -base64 48
# L'API refuse de démarrer sans un secret fort — voir src/auth/jwt-secret.ts.
JWT_SECRET=""
JWT_EXPIRES_IN="12h"
PORT=3001

# --- Abonnements (facultatif) ---------------------------------------------
# Sans STRIPE_SECRET_KEY, l'application démarre et fonctionne normalement :
# seuls les abonnements payants sont désactivés, l'essai reste accordé à
# l'inscription. C'est le mode attendu tant qu'aucune société n'est
# immatriculée — Stripe exige une identité vérifiée pour encaisser.
STRIPE_SECRET_KEY=""
# Secret de signature du webhook, donné par Stripe à la création du point de
# terminaison. Sans lui, aucun événement n'est authentifié : quiconque
# connaîtrait l'URL pourrait s'octroyer un abonnement.
STRIPE_WEBHOOK_SECRET=""

# Identifiants de tarif Stripe, un par formule. Les montants ne sont jamais
# écrits ici : ils vivent dans Stripe, et le code n'en connaît que la
# référence — sinon le prix affiché finit par diverger du prix facturé.
# Ces identifiants diffèrent entre le mode test et le mode production.
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_CABINET=""
STRIPE_PRICE_GROUPE=""

# Base des URL de retour après paiement (succès, annulation, portail).
APP_URL="http://localhost:5173"
