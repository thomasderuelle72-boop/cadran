generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DAF
  CONTROLEUR
  LECTEUR
}

enum PeriodStatus {
  OUVERTE
  CLOTUREE
}

enum AlertOperator {
  LT
  LTE
  GT
  GTE
}

// Poste normalisé : catégorie comptable standardisée à laquelle chaque ligne
// importée est rattachée. Le moteur de ratios (apps/api/src/ratios/engine.ts)
// n'agrège jamais un numéro de compte brut, toujours ces postes.
enum LinePoste {
  CHIFFRE_AFFAIRES
  ACHATS_CONSOMMES
  CHARGES_EXTERNES
  CHARGES_PERSONNEL
  IMPOTS_TAXES
  DOTATIONS_AMORTISSEMENTS
  AUTRES_PRODUITS_CHARGES_EXPLOITATION
  CHARGES_FINANCIERES
  PRODUITS_FINANCIERS
  RESULTAT_EXCEPTIONNEL
  IMPOT_SOCIETES
  STOCKS
  CREANCES_CLIENTS
  AUTRES_CREANCES
  DISPONIBILITES
  CAPITAUX_PROPRES
  DETTES_FINANCIERES
  DETTES_FOURNISSEURS
  AUTRES_DETTES
  IMMOBILISATIONS
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  currency  String   @default("EUR")
  createdAt DateTime @default(now())

  users      User[]
  entities   Entity[]
  alertRules AlertRule[]
  auditLogs  AuditLog[]
  actionPlans ActionPlan[]
  subscription Subscription?
}

enum PlanId {
  essai
  solo
  cabinet
  groupe
}

// Les statuts sont ceux de Stripe, traduits mais non réinventés : un second
// vocabulaire obligerait à tenir une table de correspondance, qui finirait
// par diverger au premier statut ajouté chez Stripe.
enum StatutAbonnement {
  essai
  actif
  impaye
  resilie
  incomplet
}

// L'abonnement d'une organisation.
//
// Il n'y a délibérément aucun prix ici : le montant facturé est celui que
// Stripe applique au tarif référencé, et le dupliquer en base garantit qu'un
// jour les deux diffèrent — au détriment du client, qui le découvre sur son
// relevé.
//
// Les champs Stripe sont facultatifs parce qu'un essai n'a ni client ni
// abonnement chez Stripe : il naît à l'inscription, sans qu'aucun moyen de
// paiement n'ait été demandé.
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan   PlanId           @default(essai)
  statut StatutAbonnement @default(essai)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  /// Tarif effectivement souscrit, pour détecter un changement de formule.
  stripePriceId        String?

  /// Fin de l'essai, ou fin de la période payée en cours.
  finPeriode DateTime?
  /// Posé quand le client résilie : l'accès court jusqu'à finPeriode.
  resiliationDemandee Boolean @default(false)

  // Assujettissement : un client professionnel avec numéro intracommunautaire
  // valide relève de l'autoliquidation, un particulier de la TVA de son pays.
  // Le numéro est conservé parce qu'il doit être reporté sur la facture.
  numeroTva String?
  paysTva   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

// Journal des événements Stripe déjà traités.
//
// Stripe garantit une livraison « au moins une fois » : le même événement
// peut arriver deux fois, et le rejouer accorderait deux fois un changement
// de formule ou un crédit. L'identifiant Stripe est unique ici, ce qui rend
// le second passage inoffensif.
model StripeEvent {
  id        String   @id
  type      String
  recuLe    DateTime @default(now())
  traiteLe  DateTime?
  /// Renseigné si le traitement a échoué : garde la trace pour rejouer.
  erreur    String?

  @@index([type])
}

// Piste d'audit : trace chaque opération qui modifie des données, écrite par
// un interceptor global (src/audit/audit.interceptor.ts). Volontairement en
// écriture seule — aucun code applicatif ne met à jour ni ne supprime une
// entrée — et l'e-mail de l'auteur y est recopié pour que la trace reste
// lisible même si le compte est supprimé plus tard.
// Jeton de réinitialisation de mot de passe.
//
// Le jeton lui-même n'est jamais stocké : la base garde son empreinte
// SHA-256, comme pour un mot de passe. Une fuite de cette table ne permet
// donc de reprendre aucun compte.
//
// `utiliseLe` rend le jeton à usage unique : sans lui, un lien intercepté
// resterait valable après le changement de mot de passe légitime.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empreinte String   @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expireLe])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  userEmail      String
  userRole       Role?
  action         String
  method         String
  path           String
  statusCode     Int
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(LECTEUR)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  passwordResets PasswordResetToken[]
}

// Filiale / société du groupe. Le pilotage mono-entité du MVP devient un cas
// particulier (une organisation avec une seule entité) : rien ne change pour
// les petites structures, la consolidation ne fait que sommer un groupe d'une
// seule entité.
model Entity {
  id                    String   @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  name                  String
  country               String?
  currency              String   @default("EUR")
  // Taux de conversion appliqué lors de la consolidation pour ramener les
  // montants de cette entité dans la devise de référence du groupe. Saisi
  // manuellement en V1 (pas d'flux de cours de change en temps réel).
  fxRateToOrgCurrency   Float    @default(1)
  // Code d'activité principal (NAF/APE, ex. "4791B") et effectif moyen :
  // les deux clés qui permettent de situer l'entité dans une cohorte
  // sectorielle comparable. Facultatifs — sans eux, le benchmark est
  // simplement indisponible pour cette entité.
  nafCode               String?
  headcount             Int?
  createdAt             DateTime @default(now())

  periods           AccountingPeriod[]
  cashForecastLines CashForecastLine[]
  ledgerEntries     LedgerEntry[]
  actionPlans       ActionPlan[]

  @@unique([organizationId, name])
}

enum CashCategory {
  ENCAISSEMENTS_CLIENTS
  DECAISSEMENTS_FOURNISSEURS
  SALAIRES_ET_CHARGES_SOCIALES
  IMPOTS_ET_TAXES
  LOYERS_ET_CHARGES_EXTERNES
  REMBOURSEMENT_EMPRUNT
  INVESTISSEMENT
  FINANCEMENT
  AUTRE
}

enum CashRecurrence {
  NONE
  WEEKLY
  MONTHLY
}

// Flux prévisionnel de trésorerie d'une entité. Le montant est signé :
// positif pour un encaissement, négatif pour un décaissement. Une ligne
// récurrente est développée en occurrences par le moteur de projection
// (src/cash-forecast/engine.ts) jusqu'à endDate ou l'horizon demandé.
model CashForecastLine {
  id         String         @id @default(cuid())
  entityId   String
  entity     Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  label      String
  category   CashCategory
  amount     Decimal        @db.Decimal(14, 2)
  startDate  DateTime
  recurrence CashRecurrence @default(NONE)
  endDate    DateTime?
  createdAt  DateTime       @default(now())

  @@index([entityId, startDate])
}

enum ActionStatus {
  A_FAIRE
  EN_COURS
  FAITE
  ABANDONNEE
}

enum PeriodSource {
  MANUEL
  FEC
}

// Écriture comptable issue d'un Fichier des Écritures Comptables (FEC), le
// format normé par l'arrêté du 29 juillet 2013 que tout logiciel comptable
// français sait exporter.
//
// C'est la couche de détail sous les agrégats : FinancialLineItem reste la
// matière du moteur de ratios, mais elle est désormais *dérivée* de ces
// lignes plutôt que saisie. Ce sont elles qui permettent de répondre aux
// questions qu'un agrégat ne peut pas : quel client doit quoi, depuis
// quand, et quel compte exactement a dérapé ce mois-ci.
//
// Les champs sont ceux du FEC, au nom près ; les quatre qui comptent sont
// entryDate (mensualisation), accountCode (détail sous l'agrégat),
// auxAccountCode (le tiers) et lettering (ce qui est réglé).
model LedgerEntry {
  id             String    @id @default(cuid())
  entityId       String
  entity         Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  // Exercice d'origine, au format AAAA : un réimport du même exercice
  // remplace l'intégralité de ses écritures, sans toucher aux autres.
  fiscalYear     Int
  journalCode    String
  journalLabel   String
  entryNum       String
  entryDate      DateTime
  accountCode    String
  accountLabel   String
  auxAccountCode String?
  auxAccountLabel String?
  pieceRef       String?
  pieceDate      DateTime?
  label          String
  debit          Decimal   @db.Decimal(14, 2)
  credit         Decimal   @db.Decimal(14, 2)
  // Lettrage : une écriture lettrée est rapprochée de sa contrepartie, donc
  // réglée. L'encours d'une balance âgée, c'est exactement le non lettré.
  lettering      String?
  letteringDate  DateTime?
  validDate      DateTime?
  createdAt      DateTime  @default(now())

  @@index([entityId, fiscalYear])
  @@index([entityId, entryDate])
  @@index([entityId, accountCode])
  @@index([entityId, auxAccountCode])
}

model AccountingPeriod {
  id        String       @id @default(cuid())
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id])
  label     String
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(OUVERTE)
  // Origine des montants : saisis/importés en balance (MANUEL) ou dérivés
  // des écritures d'un FEC (FEC). Une période dérivée est régénérée à chaque
  // réimport du fichier ; la modifier à la main n'aurait pas de sens.
  source    PeriodSource @default(MANUEL)
  createdAt DateTime     @default(now())

  lineItems   FinancialLineItem[]
  ratioResult RatioResult?
  budgetLines BudgetLine[]

  @@unique([entityId, label])
  @@index([entityId, startDate])
}

model FinancialLineItem {
  id           String           @id @default(cuid())
  periodId     String
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  accountCode  String
  label        String
  amount       Decimal          @db.Decimal(14, 2)
  poste        LinePoste
  createdAt    DateTime         @default(now())

  @@index([periodId, poste])
}

// Cache du dernier calcul de ratios pour la période (recalculé à chaque
// import ou clôture). Évite de recalculer à chaque affichage du dashboard.
model RatioResult {
  id         String           @id @default(cuid())
  periodId   String           @unique
  period     AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  aggregates Json
  derived    Json
  ratios     Json
  computedAt DateTime         @default(now())
}

// Montant budgété pour un poste donné, sur la même période que les lignes
// réelles importées : la comparaison budget/réalisé se fait poste par poste,
// puis les écarts sont recalculés avec le même moteur que les ratios.
model BudgetLine {
  id             String           @id @default(cuid())
  periodId       String
  period         AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  poste          LinePoste
  amountBudgeted Decimal          @db.Decimal(14, 2)
  createdAt      DateTime         @default(now())

  @@unique([periodId, poste])
}

// Règle définissant un seuil à surveiller sur un ratio (ex: liquidité
// générale < 1.0). Évaluée à chaque recalcul de ratios pour toutes les
// entités de l'organisation.
model AlertRule {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  label          String
  ratioId        String
  operator       AlertOperator
  threshold      Float
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  events AlertEvent[]

  @@index([organizationId, active])
}

// Déclenchement effectif d'une règle pour une entité/période donnée. Un seul
// événement par (règle, période) : il est mis à jour tant que le seuil reste
// franchi, et supprimé dès que ce n'est plus le cas (cf RatiosService).
model AlertEvent {
  id           String    @id @default(cuid())
  alertRuleId  String
  alertRule    AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  entityId     String
  periodId     String
  value        Float
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([alertRuleId, periodId])
}

// Recommandation de conseil, tracée et mesurée.
//
// C'est ce qui distingue un outil de conseil d'un outil de reporting : sans
// cette table, une recommandation n'est qu'une phrase dite en réunion. Avec
// elle, le constat, l'action, son impact chiffré, son responsable et son
// échéance sont écrits, et l'outil peut relire l'indicateur au point suivant
// pour dire si la cible a été atteinte.
//
// Un indicateur suivi (ratioId) est facultatif : certaines actions ne se
// mesurent pas par un ratio. Quand il est renseigné, la progression se lit
// automatiquement contre la dernière période de l'entité — c'est ce qui rend
// le conseil facturable sur sa valeur plutôt que sur son temps.
model ActionPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id])
  constat        String
  action         String
  /// Identifiant du ratio suivi, au sens du moteur (ratios/engine.ts).
  ratioId        String?
  valeurInitiale Float?
  valeurCible    Float?
  /// Gain de trésorerie ou de résultat attendu, dans la devise de l'entité.
  impactEstime   Decimal?     @db.Decimal(14, 2)
  responsable    String?
  echeance       DateTime?
  statut         ActionStatus @default(A_FAIRE)
  /// Auteur de la recommandation, recopié pour rester lisible si le compte part.
  auteurEmail    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, statut])
  @@index([entityId])
}
